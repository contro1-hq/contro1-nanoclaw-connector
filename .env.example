# Keys the contro1 channel reads from NanoClaw's .env. NanoClaw reads .env
# without loading it into process.env, so none of this reaches agent containers.

# Required: the Agent Credential for this NanoClaw host. Prefer the file form.
CONTRO1_AGENT_TOKEN_FILE=/etc/contro1/nanoclaw-agent.token
# CONTRO1_AGENT_TOKEN=cc_live_...

# NanoClaw user id of the Contro1 approver is contro1:<handle>.
CONTRO1_NANOCLAW_HANDLE=approvals

# Optional.
# CONTRO1_REQUIRED_ROLE=security
# CONTRO1_API_URL=https://api.contro1.com
# CONTRO1_CLI=/usr/local/bin/contro1
# NANOCLAW_NCL=/opt/nanoclaw/bin/ncl
# CONTRO1_POLL_INTERVAL_MS=5000
# CONTRO1_EXPIRY_MINUTES=1440
